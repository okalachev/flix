	{"IMU_ACC_SCALE_Y", &accScale.y},
	{"IMU_ACC_SCALE_Z", &accScale.z},
	{"IMU_GYRO_BIAS_A", &gyroBiasFilter.alpha},
	// 【R10 新增】IMU 自动识别 / 朝向锁定
	// IMU_AUTO_DETECT=1：开机裸读 WHO_AM_I 判断是 MPU6050(I2C) 还是 MPU6500(SPI)，
