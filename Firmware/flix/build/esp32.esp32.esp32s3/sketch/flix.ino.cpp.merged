"\n"
TXT_HELP_TITLE
TXT_HELP_HELP
TXT_HELP_P
TXT_HELP_P_STR
TXT_HELP_P_SET
TXT_HELP_PRESET
TXT_HELP_TIME
TXT_HELP_IMU
TXT_HELP_CA
TXT_HELP_ST
TXT_HELP_ARM
TXT_HELP_MODE
TXT_HELP_RC
TXT_HELP_CR
TXT_HELP_PW
