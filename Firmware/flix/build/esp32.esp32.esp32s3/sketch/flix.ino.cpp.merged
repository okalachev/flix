	{"CTL_RATE_Y_D_A", &yawRatePID.lpf.alpha},
	{"CTL_RATE_P_MAX", &maxRate.y},
	{"CTL_RATE_R_MAX", &maxRate.x},
	{"CTL_RATE_Y_MAX", &maxRate.z},
	{"CTL_ATT_R_P", &rollPID.p},
	{"CTL_ATT_P_P", &pitchPID.p},
